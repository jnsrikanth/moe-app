{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-server",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false,
    "incremental": false,
    "allowImportingTsExtensions": false
  },
  "include": ["server/**/*", "shared/**/*", "types/**/*.d.ts"],
  "exclude": [
    "client",
    "dist",
    "dist-server",
    "node_modules",
    "server/sqlite-storage.ts"
  ]
}
