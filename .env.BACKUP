# DO NOT PUT REAL SECRETS HERE
# Sanitized backup for local development and sandbox machines.
# Copy to .env and fill in real values via a secure channel.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=1

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
# Optional override for single-file logging (dev launcher also uses this path)
LOG_FILE=/tmp/moe-app-dev.log

# Public base URL when accessed behind a proxy (optional)
# PROXY_BASE_URL=https://your-proxy.example.com

# Routing engine (llm | ml | rules | hybrid)
ROUTER_ENGINE=llm

# Optional kill switch for external LLM calls (1 = disable, 0 = enable)
GROQ_KILL_SWITCH=0

# Groq (example placeholder)
GROQ_API_KEY={{GROQ_API_KEY}}

# Vertex AI (example placeholders)
VERTEX_AI_PROJECT={{VERTEX_AI_PROJECT}}
VERTEX_AI_LOCATION={{VERTEX_AI_LOCATION}}
VERTEX_AI_MODEL=gemini-1.5-flash

# Storage backend
# Options: mem | json | sqlite
STORAGE=json
# For json backend
JSON_STORE_PATH=./data/moe-data.json
# For sqlite backend
# SQLITE_PATH=./data/moe.db
