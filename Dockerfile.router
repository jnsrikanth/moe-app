FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    LOG_LEVEL=WARNING \
    ROUTER_STRATEGY=ml

WORKDIR /app

# Vendored wheels for offline build
COPY vendor/python/py311/wheels /wheels

# App source and models
COPY agents /app/agents
COPY models /app/models

# Install runtime deps from wheelhouse
RUN pip install --no-cache-dir --no-index --find-links=/wheels \
    fastapi==0.115.0 uvicorn[standard]==0.30.6 pydantic==2.8.2 httpx==0.27.2 \
    numpy==1.26.4 scipy==1.11.4 scikit-learn==1.4.2 joblib==1.4.2

# Cloud Run will inject $PORT; bind to it
CMD ["sh", "-lc", "exec uvicorn agents.moe_router.main:app --host 0.0.0.0 --port ${PORT}"]
